#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* FILA 1 */
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6

                /* FILA 2 */
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y

                /* FILA 3 */
                &kp A  &kp S  &kp D  &kp F  &kp G  &kp H

                /* 3 TECLAS INFERIORES */
                &kp LEFT &kp DOWN &kp RIGHT
            >;
        };
    };
};
