#include <dt-bindings/zmk/matrix_transform.h>

/*
 * TEST AISLADO DEL LADO DERECHO
 * nRF52840 -> I2C -> MCP23017 -> matriz derecha
 *
 * SDA = P0.06 / serigrafia 006
 * SCL = P0.08 / serigrafia 008
 *
 * MCP23017:
 * A0/A1/A2 de direccion -> GND => I2C 0x20
 *
 * Matriz:
 * C1..C6 -> GPA0..GPA5
 * R1..R4 -> GPB0..GPB3
 */

&pinctrl {
    pocket_i2c_default: pocket_i2c_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 6)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };

    pocket_i2c_sleep: pocket_i2c_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 6)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;
            low-power-enable;
        };
    };
};

&pro_micro_i2c {
    compatible = "nordic,nrf-twim";
    status = "okay";

    pinctrl-0 = <&pocket_i2c_default>;
    pinctrl-1 = <&pocket_i2c_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    mcp23017: gpio@20 {
        compatible = "microchip,mcp23017";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        status = "okay";
    };
};

/ {
    chosen {
        zmk,kscan = &kscan_right;
        zmk,matrix-transform = &right_transform;
    };

    kscan_right: kscan_right {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        /*
         * Columnas: GPA0..GPA5
         */
        col-gpios =
            <&mcp23017 0 GPIO_ACTIVE_HIGH>,
            <&mcp23017 1 GPIO_ACTIVE_HIGH>,
            <&mcp23017 2 GPIO_ACTIVE_HIGH>,
            <&mcp23017 3 GPIO_ACTIVE_HIGH>,
            <&mcp23017 4 GPIO_ACTIVE_HIGH>,
            <&mcp23017 5 GPIO_ACTIVE_HIGH>;

        /*
         * Filas: GPB0..GPB3
         * Tus resistencias externas de 10k van de B0..B3 a GND.
         */
        row-gpios =
            <&mcp23017 8 GPIO_ACTIVE_HIGH>,
            <&mcp23017 9 GPIO_ACTIVE_HIGH>,
            <&mcp23017 10 GPIO_ACTIVE_HIGH>,
            <&mcp23017 11 GPIO_ACTIVE_HIGH>;
    };

    right_transform: right_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <6>;

        /*
         * 18 teclas principales + 3 inferiores.
         * Si físicamente el derecho está espejado, después
         * invertimos solo este mapa.
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(3,0) RC(3,1) RC(3,2)
        >;
    };
};
