#include <dt-bindings/zmk/matrix_transform.h>

/* ============================================================
 * I2C PARA EL MCP23017
 *
 * SDA -> P0.06 -> serigrafia 006
 * SCL -> P0.08 -> serigrafia 008
 * ============================================================
 */

&pinctrl {
    pocket_i2c_default: pocket_i2c_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 6)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };

    pocket_i2c_sleep: pocket_i2c_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 6)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;
            low-power-enable;
        };
    };
};

/* ============================================================
 * I2C + MCP23017
 * A0/A1/A2 -> GND => direccion 0x20
 * ============================================================
 */

&pro_micro_i2c {
    compatible = "nordic,nrf-twim";
    status = "okay";

    pinctrl-0 = <&pocket_i2c_default>;
    pinctrl-1 = <&pocket_i2c_sleep>;
    pinctrl-names = "default", "sleep";

    clock-frequency = <100000>;

    mcp23017: gpio@20 {
        compatible = "microchip,mcp23017";
        reg = <0x20>;

        gpio-controller;
        #gpio-cells = <2>;

        status = "okay";
    };
};

/* ============================================================
 * TECLADO COMPLETO
 * ============================================================
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /* --------------------------------------------------------
     * COMBINAMOS IZQUIERDA + DERECHA
     * --------------------------------------------------------
     */

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";

        rows = <8>;
        columns = <6>;

        left {
            kscan = <&kscan_left>;
        };

        right {
            kscan = <&kscan_right>;
            row-offset = <4>;
        };
    };

    /* ========================================================
     * MATRIZ IZQUIERDA
     * ========================================================
     */

    kscan_left: kscan_left {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";

        col-gpios =
            <&pro_micro 4 GPIO_ACTIVE_HIGH>,
            <&pro_micro 5 GPIO_ACTIVE_HIGH>,
            <&pro_micro 6 GPIO_ACTIVE_HIGH>,
            <&pro_micro 10 GPIO_ACTIVE_HIGH>,
            <&pro_micro 8 GPIO_ACTIVE_HIGH>,
            <&pro_micro 9 GPIO_ACTIVE_HIGH>;

        row-gpios =
            <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    /* ========================================================
     * MATRIZ DERECHA - MCP23017
     *
     * C1 -> A0 = GPIO 0
     * C2 -> A1 = GPIO 1
     * C3 -> A2 = GPIO 2
     * C4 -> A3 = GPIO 3
     * C5 -> A4 = GPIO 4
     * C6 -> A5 = GPIO 5
     *
     * R1 -> B0 = GPIO 8
     * R2 -> B1 = GPIO 9
     * R3 -> B2 = GPIO 10
     * R4 -> B3 = GPIO 11
     * ========================================================
     */

   kscan_right: kscan_right {
    compatible = "zmk,kscan-gpio-matrix";

    diode-direction = "col2row";

    poll-period-ms = <5>;

    col-gpios =
        <&mcp23017 0 GPIO_ACTIVE_HIGH>,
        <&mcp23017 1 GPIO_ACTIVE_HIGH>,
        <&mcp23017 2 GPIO_ACTIVE_HIGH>,
        <&mcp23017 3 GPIO_ACTIVE_HIGH>,
        <&mcp23017 4 GPIO_ACTIVE_HIGH>,
        <&mcp23017 5 GPIO_ACTIVE_HIGH>;

    row-gpios =
        <&mcp23017 8 GPIO_ACTIVE_HIGH>,
        <&mcp23017 9 GPIO_ACTIVE_HIGH>,
        <&mcp23017 10 GPIO_ACTIVE_HIGH>,
        <&mcp23017 11 GPIO_ACTIVE_HIGH>;
};
    /* ========================================================
     * MAPA 42 TECLAS
     * ========================================================
     */

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";

        rows = <8>;
        columns = <6>;

        map = <
            /* IZQUIERDA */
            RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
            RC(3,2) RC(3,1) RC(3,0)

            /* DERECHA */
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)
            RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5)
            RC(7,0) RC(7,1) RC(7,2)
        >;
    };
};