#include <dt-bindings/zmk/matrix_transform.h>

/*
 * ============================================================
 * I2C PARA EL MCP23017
 *
 * Usaremos los cables que ya dejaste:
 *
 * SDA -> P0.06 -> serigrafia 006
 * SCL -> P0.08 -> serigrafia 008
 * ============================================================
 */

&pinctrl {
    pocket_i2c_default: pocket_i2c_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 6)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };

    pocket_i2c_sleep: pocket_i2c_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 6)>,
                <NRF_PSEL(TWIM_SCL, 0, 8)>;

            low-power-enable;
        };
    };
};


/*
 * ============================================================
 * ACTIVAMOS EL BUS I2C
 * ============================================================
 */

&pro_micro_i2c {
    compatible = "nordic,nrf-twim";
    status = "okay";

    pinctrl-0 = <&pocket_i2c_default>;
    pinctrl-1 = <&pocket_i2c_sleep>;
    pinctrl-names = "default", "sleep";

    clock-frequency = <100000>;


    /*
     * MCP23017
     *
     * A0 -> GND
     * A1 -> GND
     * A2 -> GND
     *
     * Por eso la direccion es 0x20.
     */
    mcp23017: gpio@20 {
        compatible = "microchip,mcp23017";

        reg = <0x20>;

        gpio-controller;
        #gpio-cells = <2>;

        ngpios = <16>;

        status = "okay";
    };
};


/*
 * ============================================================
 * MATRIZ IZQUIERDA
 *
 * POR AHORA NO TOCAMOS NADA DE LO QUE YA FUNCIONA.
 * ============================================================
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };


    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";

        col-gpios =
            <&pro_micro 4 GPIO_ACTIVE_HIGH>,
            <&pro_micro 5 GPIO_ACTIVE_HIGH>,
            <&pro_micro 6 GPIO_ACTIVE_HIGH>,
            <&pro_micro 10 GPIO_ACTIVE_HIGH>,
            <&pro_micro 8 GPIO_ACTIVE_HIGH>,
            <&pro_micro 9 GPIO_ACTIVE_HIGH>;

        row-gpios =
            <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };


    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";

        rows = <4>;
        columns = <6>;

        map = <
            RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)

            RC(3,2) RC(3,1) RC(3,0)
        >;
    };
};