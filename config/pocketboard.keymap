#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    /*
     * Easy flashing shortcut:
     * press the two OUTER keys of the LEFT thumb cluster together
     * (positions 36 + 38) to reboot the nice!nano into UF2 bootloader mode.
     */
    combos {
        compatible = "zmk,combos";

        combo_bootloader {
            timeout-ms = <250>;
            key-positions = <36 38>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp A &kp B &kp C &kp D &kp E &kp F &kp G &kp H &kp I &kp J &kp K &kp L
                &kp M &kp N &kp O &kp P &kp Q &kp R &kp S &kp T &kp U &kp V &kp W &kp X
                &kp Y &kp Z &kp A &kp B &kp C &kp D &kp E &kp F &kp G &kp H &kp I &kp J
                &kp K &kp L &kp M &kp N &kp O &kp P
            >;
        };
    };
};
